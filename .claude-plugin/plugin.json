{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "cern-opendata-mcp-server",
  "version": "0.1.0",
  "description": "CERN Open Data Portal: search LHC collision and simulated datasets, analysis environments, and trigger configurations from ATLAS, CMS, ALICE, and LHCb.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/cern-opendata-mcp-server",
  "repository": "https://github.com/cyanheads/cern-opendata-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "cern", "open-data", "particle-physics", "lhc", "cms", "atlas"],
  "mcpServers": {
    "cern-opendata-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/cern-opendata-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
