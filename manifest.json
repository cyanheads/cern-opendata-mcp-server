{
  "manifest_version": "0.3",
  "name": "cern-opendata-mcp-server",
  "version": "0.2.0",
  "description": "Search CERN Open Data, fetch records, files, analysis environments, CMS good-run lists, HLT paths.",
  "author": { "name": "cyanheads" },
  "repository": { "type": "git", "url": "https://github.com/cyanheads/cern-opendata-mcp-server" },
  "homepage": "https://github.com/cyanheads/cern-opendata-mcp-server#readme",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "cern",
    "cern-open-data",
    "open-data",
    "particle-physics",
    "high-energy-physics",
    "lhc",
    "cms",
    "atlas",
    "alice",
    "lhcb",
    "xrootd"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {}
}
